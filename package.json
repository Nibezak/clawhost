{
    "name": "openclaw",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "turbo dev",
        "build": "turbo build",
        "dev:web": "pnpm --filter web dev",
        "dev:api": "pnpm --filter api dev",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write . && eslint . --fix",
        "format:check": "prettier --check .",
        "check": "pnpm --filter api check && pnpm --filter web check",
        "version:patch": "pnpm --filter api exec npm version patch --no-git-tag-version && pnpm --filter web exec npm version patch --no-git-tag-version",
        "prepare": "husky"
    },
    "devDependencies": {
        "@eslint/js": "^9.17.0",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-react-hooks": "^5.1.0",
        "eslint-plugin-react-refresh": "^0.4.16",
        "globals": "^17.3.0",
        "husky": "^9.1.7",
        "prettier": "^3.4.2",
        "prettier-plugin-tailwindcss": "^0.6.9",
        "turbo": "^2.3.0",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.18.2"
    },
    "packageManager": "pnpm@9.14.2",
    "engines": {
        "node": ">=20"
    }
}
